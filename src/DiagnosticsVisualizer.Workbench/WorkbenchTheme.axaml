<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="DvBackground">#1F2124</SolidColorBrush>
    <SolidColorBrush x:Key="DvSurface">#2B2D30</SolidColorBrush>
    <SolidColorBrush x:Key="DvBorder">#3C3F41</SolidColorBrush>
    <SolidColorBrush x:Key="DvForeground">#DFE1E5</SolidColorBrush>
    <SolidColorBrush x:Key="DvMuted">#9DA0A8</SolidColorBrush>
    <SolidColorBrush x:Key="DvAccent">#4C9FFF</SolidColorBrush>
  </Styles.Resources>
  <Style Selector="Button.dv-toolbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="MinHeight" Value="30" />
  </Style>
  <Style Selector="Button.dv-primary">
    <Setter Property="Background" Value="#35537A" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#4C9FFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector=".dv-workbench DataGrid">
    <Setter Property="Background" Value="#1F2124" />
    <Setter Property="Foreground" Value="#DFE1E5" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector=".dv-workbench DataGridColumnHeader">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Background" Value="#2B2D30" />
    <Setter Property="Foreground" Value="#9DA0A8" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector=".dv-workbench DataGridRow">
    <Setter Property="MinHeight" Value="26" />
  </Style>
  <Style Selector=".dv-workbench ListBoxItem">
    <Setter Property="Padding" Value="2,1" />
    <Setter Property="MinHeight" Value="25" />
  </Style>
  <Style Selector=".dv-workbench TabItem">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,7" />
  </Style>
  <Style Selector=".dv-workbench ToolChromeControl">
    <Setter Property="Background" Value="#1F2124" />
  </Style>
  <Style Selector=".dv-workbench DockControl">
    <Setter Property="Background" Value="#1F2124" />
  </Style>
</Styles>
