<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Version Condition="'$(Version)' == ''">0.1.0-alpha.4</Version>
    <Authors>Wiesław Šoltés</Authors>
    <RepositoryUrl>https://github.com/wieslawsoltes/DisgnosticsVisualizer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/wieslawsoltes/DisgnosticsVisualizer</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Composable Avalonia instrumentation, binary tracing, analysis and visual diagnostics.</Description>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>true</IsPackable>
    <AvaloniaVersion>11.3.22</AvaloniaVersion>
    <DockVersion>11.3.22</DockVersion>
    <DockModelVersion>12.1.0.7</DockModelVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/README.md" />
  </ItemGroup>
</Project>
